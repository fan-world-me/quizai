{
  "manifest_version": 3,
  "name": "Quiz AI Analyzer",
  "version": "2.1",
  "description": "Автоаналіз тестів: vseosvita.ua, zno.osvita.ua, naurok.ua, Moodle, Google Forms, Kahoot та інші. Аналіз зображень. NVIDIA / OpenRouter / Gemini / Groq AI. Author: fan_world_me",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "clipboardRead",
    "<all_urls>"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["Monocraft.ttf"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "quiz-ai-analyzer@quizai.app",
      "strict_min_version": "109.0"
    },
    "gecko_android": {
      "strict_min_version": "113.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
